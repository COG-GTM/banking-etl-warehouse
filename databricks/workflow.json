{
  "name": "banking_dwh_etl_pipeline",
  "description": "End-to-end Databricks pipeline replacing the legacy Talend ETL + SQL Server DWH system. Follows Bronze/Silver/Gold medallion architecture.",
  "tags": {
    "project": "banking-etl-warehouse",
    "migration": "talend-to-databricks",
    "architecture": "medallion"
  },
  "job_clusters": [
    {
      "job_cluster_key": "etl_cluster",
      "new_cluster": {
        "spark_version": "14.3.x-scala2.12",
        "node_type_id": "Standard_DS3_v2",
        "num_workers": 1,
        "spark_conf": {
          "spark.sql.shuffle.partitions": "8",
          "spark.databricks.delta.optimizeWrite.enabled": "true",
          "spark.databricks.delta.autoCompact.enabled": "true"
        },
        "runtime_engine": "PHOTON"
      }
    }
  ],
  "tasks": [
    {
      "task_key": "setup_source_data",
      "description": "Upload and prepare source data files in Unity Catalog volumes",
      "job_cluster_key": "etl_cluster",
      "notebook_task": {
        "notebook_path": "/Repos/banking-etl-warehouse/databricks/setup/upload_source_data",
        "source": "GIT"
      },
      "timeout_seconds": 600
    },
    {
      "task_key": "bronze_ingest_sql_tables",
      "description": "Ingest SQL Server source tables (customer, city, state, account, branch, transaction) into Bronze layer",
      "depends_on": [
        { "task_key": "setup_source_data" }
      ],
      "job_cluster_key": "etl_cluster",
      "notebook_task": {
        "notebook_path": "/Repos/banking-etl-warehouse/databricks/bronze/ingest_sql_server_tables",
        "source": "GIT"
      },
      "timeout_seconds": 600
    },
    {
      "task_key": "bronze_ingest_csv",
      "description": "Ingest transaction CSV file into Bronze layer",
      "depends_on": [
        { "task_key": "setup_source_data" }
      ],
      "job_cluster_key": "etl_cluster",
      "notebook_task": {
        "notebook_path": "/Repos/banking-etl-warehouse/databricks/bronze/ingest_transactions_csv",
        "source": "GIT"
      },
      "timeout_seconds": 600
    },
    {
      "task_key": "bronze_ingest_excel",
      "description": "Ingest transaction Excel file into Bronze layer",
      "depends_on": [
        { "task_key": "setup_source_data" }
      ],
      "job_cluster_key": "etl_cluster",
      "notebook_task": {
        "notebook_path": "/Repos/banking-etl-warehouse/databricks/bronze/ingest_transactions_excel",
        "source": "GIT"
      },
      "timeout_seconds": 600
    },
    {
      "task_key": "silver_dim_branch",
      "description": "Build DimBranch dimension table (replaces Talend Load_DimBranch)",
      "depends_on": [
        { "task_key": "bronze_ingest_sql_tables" }
      ],
      "job_cluster_key": "etl_cluster",
      "notebook_task": {
        "notebook_path": "/Repos/banking-etl-warehouse/databricks/silver/build_dim_branch",
        "source": "GIT"
      },
      "timeout_seconds": 600
    },
    {
      "task_key": "silver_dim_account",
      "description": "Build DimAccount dimension table (replaces Talend Load_DimAccount)",
      "depends_on": [
        { "task_key": "bronze_ingest_sql_tables" }
      ],
      "job_cluster_key": "etl_cluster",
      "notebook_task": {
        "notebook_path": "/Repos/banking-etl-warehouse/databricks/silver/build_dim_account",
        "source": "GIT"
      },
      "timeout_seconds": 600
    },
    {
      "task_key": "silver_dim_customer",
      "description": "Build DimCustomer dimension table with city/state join and uppercase normalization (replaces Talend Load_DimCustomer)",
      "depends_on": [
        { "task_key": "bronze_ingest_sql_tables" }
      ],
      "job_cluster_key": "etl_cluster",
      "notebook_task": {
        "notebook_path": "/Repos/banking-etl-warehouse/databricks/silver/build_dim_customer",
        "source": "GIT"
      },
      "timeout_seconds": 600
    },
    {
      "task_key": "silver_fact_transaction",
      "description": "Build FactTransaction fact table — union 3 sources, deduplicate (replaces Talend Load_FactTransaction)",
      "depends_on": [
        { "task_key": "bronze_ingest_sql_tables" },
        { "task_key": "bronze_ingest_csv" },
        { "task_key": "bronze_ingest_excel" }
      ],
      "job_cluster_key": "etl_cluster",
      "notebook_task": {
        "notebook_path": "/Repos/banking-etl-warehouse/databricks/silver/build_fact_transaction",
        "source": "GIT"
      },
      "timeout_seconds": 600
    },
    {
      "task_key": "gold_daily_transaction_summary",
      "description": "Build daily transaction summary aggregate (replaces sp_DailyTransaction)",
      "depends_on": [
        { "task_key": "silver_fact_transaction" }
      ],
      "job_cluster_key": "etl_cluster",
      "notebook_task": {
        "notebook_path": "/Repos/banking-etl-warehouse/databricks/gold/daily_transaction_summary",
        "source": "GIT"
      },
      "timeout_seconds": 600
    },
    {
      "task_key": "gold_balance_per_customer",
      "description": "Build balance per customer reconciliation (replaces sp_BalancePerCustomer)",
      "depends_on": [
        { "task_key": "silver_dim_customer" },
        { "task_key": "silver_dim_account" },
        { "task_key": "silver_fact_transaction" }
      ],
      "job_cluster_key": "etl_cluster",
      "notebook_task": {
        "notebook_path": "/Repos/banking-etl-warehouse/databricks/gold/balance_per_customer",
        "source": "GIT"
      },
      "timeout_seconds": 600
    }
  ],
  "format": "MULTI_TASK",
  "max_concurrent_runs": 1,
  "schedule": {
    "quartz_cron_expression": "0 0 6 * * ?",
    "timezone_id": "Asia/Jakarta",
    "pause_status": "PAUSED"
  },
  "email_notifications": {
    "on_failure": [],
    "on_success": [],
    "no_alert_for_skipped_runs": true
  }
}
