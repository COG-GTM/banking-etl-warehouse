{
  "name": "banking-etl-job-cluster",
  "description": "Job clusters for the banking-etl-warehouse bundle: DBR 17.3 LTS, dedicated (single-user) access mode for Unity Catalog, small AWS node allow-list, mandatory tags.",
  "definition": {
    "cluster_type": {"type": "fixed", "value": "job"},
    "spark_version": {"type": "allowlist", "values": ["17.3.x-scala2.13", "17.3.x-photon-scala2.13"], "defaultValue": "17.3.x-scala2.13"},
    "runtime_engine": {"type": "allowlist", "values": ["STANDARD", "PHOTON"], "defaultValue": "STANDARD"},
    "data_security_mode": {"type": "allowlist", "values": ["SINGLE_USER", "DATA_SECURITY_MODE_DEDICATED"], "defaultValue": "SINGLE_USER"},
    "node_type_id": {"type": "allowlist", "values": ["i3.xlarge", "i3.2xlarge", "m5d.large", "m5d.xlarge", "r5d.large"], "defaultValue": "i3.xlarge"},
    "driver_node_type_id": {"type": "allowlist", "values": ["i3.xlarge", "i3.2xlarge", "m5d.large", "m5d.xlarge", "r5d.large"], "defaultValue": "i3.xlarge"},
    "num_workers": {"type": "range", "minValue": 0, "maxValue": 4, "defaultValue": 1, "isOptional": true},
    "autoscale.min_workers": {"type": "range", "minValue": 1, "maxValue": 2, "defaultValue": 1, "isOptional": true},
    "autoscale.max_workers": {"type": "range", "minValue": 1, "maxValue": 8, "defaultValue": 4, "isOptional": true},
    "autotermination_minutes": {"type": "range", "minValue": 10, "maxValue": 60, "defaultValue": 20, "isOptional": true},
    "aws_attributes.availability": {"type": "allowlist", "values": ["SPOT_WITH_FALLBACK", "ON_DEMAND"], "defaultValue": "SPOT_WITH_FALLBACK"},
    "aws_attributes.first_on_demand": {"type": "range", "minValue": 1, "defaultValue": 1},
    "aws_attributes.zone_id": {"type": "unlimited", "defaultValue": "auto", "hidden": true},
    "enable_elastic_disk": {"type": "fixed", "value": true, "hidden": true},
    "instance_pool_id": {"type": "forbidden", "hidden": true},
    "driver_instance_pool_id": {"type": "forbidden", "hidden": true},
    "custom_tags.project": {"type": "fixed", "value": "banking-etl-warehouse"},
    "custom_tags.managed_by": {"type": "fixed", "value": "databricks-asset-bundle"},
    "custom_tags.cost_center": {"type": "unlimited", "defaultValue": "data-engineering"},
    "custom_tags.environment": {"type": "allowlist", "values": ["dev", "prod"], "defaultValue": "dev"}
  }
}
