{
  "name": "banking_dwh_etl",
  "description": "PySpark/Delta migration of the Talend jobs Load_DimBranch, Load_DimAccount, Load_DimCustomer and Load_FactTransaction, followed by the sp_DailyTransaction and sp_BalancePerCustomer analytics. Create via `databricks jobs create --json @databricks/workflows/etl_job.json` after replacing <user> in python_file paths.",
  "max_concurrent_runs": 1,
  "parameters": [
    {
      "name": "catalog",
      "default": "main"
    },
    {
      "name": "target_schema",
      "default": "dwh"
    },
    {
      "name": "secret_scope",
      "default": "banking-etl"
    },
    {
      "name": "jdbc_host",
      "default": ""
    },
    {
      "name": "jdbc_port",
      "default": "1433"
    },
    {
      "name": "jdbc_database",
      "default": "sample"
    },
    {
      "name": "write_mode",
      "default": "merge"
    },
    {
      "name": "csv_path",
      "default": "/Volumes/main/banking_raw/landing/transaction_csv.csv"
    },
    {
      "name": "excel_path",
      "default": "/Volumes/main/banking_raw/landing/transaction_excel.xlsx"
    },
    {
      "name": "start_date",
      "default": "2024-01-18"
    },
    {
      "name": "end_date",
      "default": "2024-01-20"
    },
    {
      "name": "customer_name",
      "default": "Shelly"
    }
  ],
  "job_clusters": [
    {
      "job_cluster_key": "etl_cluster",
      "new_cluster": {
        "spark_version": "15.4.x-scala2.12",
        "node_type_id": "i3.xlarge",
        "num_workers": 1,
        "data_security_mode": "SINGLE_USER",
        "spark_conf": {
          "spark.sql.sources.partitionOverwriteMode": "static"
        }
      }
    }
  ],
  "tasks": [
    {
      "task_key": "create_tables",
      "job_cluster_key": "etl_cluster",
      "spark_python_task": {
        "python_file": "/Workspace/Repos/<user>/banking-etl-warehouse/databricks/jobs/create_tables.py",
        "parameters": [
          "--catalog",
          "{{job.parameters.catalog}}",
          "--target_schema",
          "{{job.parameters.target_schema}}",
          "--secret_scope",
          "{{job.parameters.secret_scope}}"
        ]
      }
    },
    {
      "task_key": "load_dim_branch",
      "job_cluster_key": "etl_cluster",
      "spark_python_task": {
        "python_file": "/Workspace/Repos/<user>/banking-etl-warehouse/databricks/jobs/load_dim_branch.py",
        "parameters": [
          "--catalog",
          "{{job.parameters.catalog}}",
          "--target_schema",
          "{{job.parameters.target_schema}}",
          "--secret_scope",
          "{{job.parameters.secret_scope}}",
          "--jdbc_host",
          "{{job.parameters.jdbc_host}}",
          "--jdbc_port",
          "{{job.parameters.jdbc_port}}",
          "--jdbc_database",
          "{{job.parameters.jdbc_database}}",
          "--write_mode",
          "{{job.parameters.write_mode}}"
        ]
      },
      "depends_on": [
        {
          "task_key": "create_tables"
        }
      ]
    },
    {
      "task_key": "load_dim_account",
      "job_cluster_key": "etl_cluster",
      "spark_python_task": {
        "python_file": "/Workspace/Repos/<user>/banking-etl-warehouse/databricks/jobs/load_dim_account.py",
        "parameters": [
          "--catalog",
          "{{job.parameters.catalog}}",
          "--target_schema",
          "{{job.parameters.target_schema}}",
          "--secret_scope",
          "{{job.parameters.secret_scope}}",
          "--jdbc_host",
          "{{job.parameters.jdbc_host}}",
          "--jdbc_port",
          "{{job.parameters.jdbc_port}}",
          "--jdbc_database",
          "{{job.parameters.jdbc_database}}",
          "--write_mode",
          "{{job.parameters.write_mode}}"
        ]
      },
      "depends_on": [
        {
          "task_key": "load_dim_branch"
        }
      ]
    },
    {
      "task_key": "load_dim_customer",
      "job_cluster_key": "etl_cluster",
      "spark_python_task": {
        "python_file": "/Workspace/Repos/<user>/banking-etl-warehouse/databricks/jobs/load_dim_customer.py",
        "parameters": [
          "--catalog",
          "{{job.parameters.catalog}}",
          "--target_schema",
          "{{job.parameters.target_schema}}",
          "--secret_scope",
          "{{job.parameters.secret_scope}}",
          "--jdbc_host",
          "{{job.parameters.jdbc_host}}",
          "--jdbc_port",
          "{{job.parameters.jdbc_port}}",
          "--jdbc_database",
          "{{job.parameters.jdbc_database}}",
          "--write_mode",
          "{{job.parameters.write_mode}}"
        ]
      },
      "depends_on": [
        {
          "task_key": "load_dim_account"
        }
      ]
    },
    {
      "task_key": "load_fact_transaction",
      "job_cluster_key": "etl_cluster",
      "spark_python_task": {
        "python_file": "/Workspace/Repos/<user>/banking-etl-warehouse/databricks/jobs/load_fact_transaction.py",
        "parameters": [
          "--catalog",
          "{{job.parameters.catalog}}",
          "--target_schema",
          "{{job.parameters.target_schema}}",
          "--secret_scope",
          "{{job.parameters.secret_scope}}",
          "--jdbc_host",
          "{{job.parameters.jdbc_host}}",
          "--jdbc_port",
          "{{job.parameters.jdbc_port}}",
          "--jdbc_database",
          "{{job.parameters.jdbc_database}}",
          "--write_mode",
          "{{job.parameters.write_mode}}",
          "--csv_path",
          "{{job.parameters.csv_path}}",
          "--excel_path",
          "{{job.parameters.excel_path}}"
        ]
      },
      "depends_on": [
        {
          "task_key": "load_dim_customer"
        }
      ],
      "libraries": [
        {
          "maven": {
            "coordinates": "com.crealytics:spark-excel_2.12:3.5.1_0.20.4"
          }
        }
      ]
    },
    {
      "task_key": "daily_transaction",
      "job_cluster_key": "etl_cluster",
      "spark_python_task": {
        "python_file": "/Workspace/Repos/<user>/banking-etl-warehouse/databricks/analytics/daily_transaction.py",
        "parameters": [
          "--catalog",
          "{{job.parameters.catalog}}",
          "--target_schema",
          "{{job.parameters.target_schema}}",
          "--secret_scope",
          "{{job.parameters.secret_scope}}",
          "--start_date",
          "{{job.parameters.start_date}}",
          "--end_date",
          "{{job.parameters.end_date}}"
        ]
      },
      "depends_on": [
        {
          "task_key": "load_fact_transaction"
        }
      ]
    },
    {
      "task_key": "balance_per_customer",
      "job_cluster_key": "etl_cluster",
      "spark_python_task": {
        "python_file": "/Workspace/Repos/<user>/banking-etl-warehouse/databricks/analytics/balance_per_customer.py",
        "parameters": [
          "--catalog",
          "{{job.parameters.catalog}}",
          "--target_schema",
          "{{job.parameters.target_schema}}",
          "--secret_scope",
          "{{job.parameters.secret_scope}}",
          "--customer_name",
          "{{job.parameters.customer_name}}"
        ]
      },
      "depends_on": [
        {
          "task_key": "load_fact_transaction"
        }
      ]
    }
  ]
}
