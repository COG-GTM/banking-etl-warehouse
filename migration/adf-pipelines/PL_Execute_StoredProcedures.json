{
    "name": "PL_Execute_StoredProcedures",
    "properties": {
        "description": "Executes the DWH analytical stored procedures (sp_DailyTransaction, sp_BalancePerCustomer) for scheduled reporting. These procedures were previously called manually via SSMS or triggered by SSIS packages.",
        "parameters": {
            "StartDate": {
                "type": "string",
                "defaultValue": ""
            },
            "EndDate": {
                "type": "string",
                "defaultValue": ""
            },
            "CustomerName": {
                "type": "string",
                "defaultValue": ""
            }
        },
        "activities": [
            {
                "name": "Set_Default_StartDate",
                "type": "SetVariable",
                "dependsOn": [],
                "typeProperties": {
                    "variableName": "effectiveStartDate",
                    "value": {
                        "value": "@if(empty(pipeline().parameters.StartDate), formatDateTime(addDays(utcNow(), -1), 'yyyy-MM-dd'), pipeline().parameters.StartDate)",
                        "type": "Expression"
                    }
                }
            },
            {
                "name": "Set_Default_EndDate",
                "type": "SetVariable",
                "dependsOn": [],
                "typeProperties": {
                    "variableName": "effectiveEndDate",
                    "value": {
                        "value": "@if(empty(pipeline().parameters.EndDate), formatDateTime(utcNow(), 'yyyy-MM-dd'), pipeline().parameters.EndDate)",
                        "type": "Expression"
                    }
                }
            },
            {
                "name": "Exec_sp_DailyTransaction",
                "type": "SqlServerStoredProcedure",
                "dependsOn": [
                    {
                        "activity": "Set_Default_StartDate",
                        "dependencyConditions": ["Succeeded"]
                    },
                    {
                        "activity": "Set_Default_EndDate",
                        "dependencyConditions": ["Succeeded"]
                    }
                ],
                "policy": {
                    "timeout": "0.00:30:00",
                    "retry": 2,
                    "retryIntervalInSeconds": 60
                },
                "typeProperties": {
                    "storedProcedureName": "sp_DailyTransaction",
                    "storedProcedureParameters": {
                        "start_date": {
                            "value": { "value": "@variables('effectiveStartDate')", "type": "Expression" },
                            "type": "DateTime"
                        },
                        "end_date": {
                            "value": { "value": "@variables('effectiveEndDate')", "type": "Expression" },
                            "type": "DateTime"
                        }
                    }
                },
                "linkedServiceName": {
                    "referenceName": "LS_SqlServer_DWH",
                    "type": "LinkedServiceReference"
                }
            },
            {
                "name": "Check_CustomerName_Provided",
                "type": "IfCondition",
                "dependsOn": [
                    {
                        "activity": "Exec_sp_DailyTransaction",
                        "dependencyConditions": ["Succeeded"]
                    }
                ],
                "typeProperties": {
                    "expression": {
                        "value": "@not(empty(pipeline().parameters.CustomerName))",
                        "type": "Expression"
                    },
                    "ifTrueActivities": [
                        {
                            "name": "Exec_sp_BalancePerCustomer",
                            "type": "SqlServerStoredProcedure",
                            "policy": {
                                "timeout": "0.00:30:00",
                                "retry": 2,
                                "retryIntervalInSeconds": 60
                            },
                            "typeProperties": {
                                "storedProcedureName": "sp_BalancePerCustomer",
                                "storedProcedureParameters": {
                                    "customer_name": {
                                        "value": { "value": "@pipeline().parameters.CustomerName", "type": "Expression" },
                                        "type": "String"
                                    }
                                }
                            },
                            "linkedServiceName": {
                                "referenceName": "LS_SqlServer_DWH",
                                "type": "LinkedServiceReference"
                            }
                        }
                    ]
                }
            }
        ],
        "variables": {
            "effectiveStartDate": { "type": "String" },
            "effectiveEndDate": { "type": "String" }
        },
        "annotations": [
            "stored-procedures",
            "reporting",
            "daily-transaction",
            "balance"
        ],
        "folder": {
            "name": "Reporting"
        }
    }
}
