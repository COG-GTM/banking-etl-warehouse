{
    "name": "DailyEtlTrigger",
    "type": "Microsoft.DataFactory/factories/triggers",
    "properties": {
        "description": "Runs the CsvToFactTransaction pipeline daily at 02:00 UTC. Adjust the schedule and time zone to match your business requirements.",
        "type": "ScheduleTrigger",
        "typeProperties": {
            "recurrence": {
                "frequency": "Day",
                "interval": 1,
                "startTime": "2025-01-01T02:00:00Z",
                "timeZone": "UTC",
                "schedule": {
                    "hours": [2],
                    "minutes": [0]
                }
            }
        },
        "pipelines": [
            {
                "pipelineReference": {
                    "referenceName": "CsvToFactTransaction",
                    "type": "PipelineReference"
                },
                "parameters": {}
            }
        ],
        "annotations": [
            "scheduled",
            "daily",
            "etl"
        ],
        "runtimeState": "Stopped"
    }
}
