{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "ARM template for Banking ETL/Data Warehouse — Azure Data Factory infrastructure. Provisions ADF, Azure SQL Database (DWH + SSISDB), Azure-SSIS IR, Self-Hosted IR, Linked Services, and diagnostic settings."
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": { "description": "Azure region for all resources." }
    },
    "namePrefix": {
      "type": "string",
      "defaultValue": "bankdwh",
      "minLength": 3,
      "maxLength": 20,
      "metadata": { "description": "Base name prefix for resource naming." }
    },
    "environment": {
      "type": "string",
      "defaultValue": "dev",
      "allowedValues": ["dev", "staging", "prod"],
      "metadata": { "description": "Environment identifier." }
    },
    "sqlAdminLogin": {
      "type": "string",
      "metadata": { "description": "SQL Server administrator login." }
    },
    "sqlAdminPassword": {
      "type": "securestring",
      "metadata": { "description": "SQL Server administrator password." }
    },
    "sqlSkuName": {
      "type": "string",
      "defaultValue": "S1",
      "allowedValues": ["Basic", "S0", "S1", "S2", "S3", "P1", "P2"],
      "metadata": { "description": "SKU name for Azure SQL Database." }
    },
    "ssisNodeSize": {
      "type": "string",
      "defaultValue": "Standard_D2_v3",
      "metadata": { "description": "Azure-SSIS IR compute node size." }
    },
    "ssisNodeCount": {
      "type": "int",
      "defaultValue": 1,
      "minValue": 1,
      "maxValue": 10,
      "metadata": { "description": "Number of nodes in the Azure-SSIS IR." }
    },
    "ssisMaxParallelExecutions": {
      "type": "int",
      "defaultValue": 4,
      "minValue": 1,
      "maxValue": 16,
      "metadata": { "description": "Max parallel executions per SSIS node." }
    },
    "ssisEdition": {
      "type": "string",
      "defaultValue": "Standard",
      "allowedValues": ["Standard", "Enterprise"],
      "metadata": { "description": "Azure-SSIS IR edition." }
    },
    "vnetResourceId": {
      "type": "string",
      "defaultValue": "",
      "metadata": { "description": "VNet resource ID for SSIS IR integration (leave empty to skip)." }
    },
    "subnetName": {
      "type": "string",
      "defaultValue": "default",
      "metadata": { "description": "Subnet name within the VNet for SSIS IR." }
    },
    "blobStorageConnectionString": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": { "description": "Azure Blob Storage connection string for CSV/Excel staging." }
    },
    "onPremSqlConnectionString": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": { "description": "On-premises SQL Server connection string (via Self-Hosted IR)." }
    },
    "logAnalyticsWorkspaceId": {
      "type": "string",
      "defaultValue": "",
      "metadata": { "description": "Log Analytics Workspace resource ID for diagnostics." }
    },
    "tags": {
      "type": "object",
      "defaultValue": {
        "project": "banking-etl-warehouse",
        "environment": "dev",
        "managedBy": "arm"
      },
      "metadata": { "description": "Tags applied to all resources." }
    }
  },
  "variables": {
    "uniqueSuffix": "[uniqueString(resourceGroup().id)]",
    "dataFactoryName": "[concat(parameters('namePrefix'), '-adf-', parameters('environment'), '-', variables('uniqueSuffix'))]",
    "sqlServerName": "[concat(parameters('namePrefix'), '-sql-', parameters('environment'), '-', variables('uniqueSuffix'))]",
    "sqlDatabaseName": "[concat(parameters('namePrefix'), '-dwh-', parameters('environment'))]",
    "ssisDbName": "SSISDB"
  },
  "resources": [
    {
      "type": "Microsoft.Sql/servers",
      "apiVersion": "2023-05-01-preview",
      "name": "[variables('sqlServerName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "properties": {
        "administratorLogin": "[parameters('sqlAdminLogin')]",
        "administratorLoginPassword": "[parameters('sqlAdminPassword')]",
        "version": "12.0",
        "minimalTlsVersion": "1.2",
        "publicNetworkAccess": "Enabled"
      }
    },
    {
      "type": "Microsoft.Sql/servers/firewallRules",
      "apiVersion": "2023-05-01-preview",
      "name": "[concat(variables('sqlServerName'), '/AllowAllAzureIps')]",
      "dependsOn": [
        "[resourceId('Microsoft.Sql/servers', variables('sqlServerName'))]"
      ],
      "properties": {
        "startIpAddress": "0.0.0.0",
        "endIpAddress": "0.0.0.0"
      }
    },
    {
      "type": "Microsoft.Sql/servers/databases",
      "apiVersion": "2023-05-01-preview",
      "name": "[concat(variables('sqlServerName'), '/', variables('sqlDatabaseName'))]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "dependsOn": [
        "[resourceId('Microsoft.Sql/servers', variables('sqlServerName'))]"
      ],
      "sku": {
        "name": "[parameters('sqlSkuName')]"
      },
      "properties": {
        "collation": "SQL_Latin1_General_CP1_CI_AS",
        "maxSizeBytes": 268435456000,
        "zoneRedundant": false
      }
    },
    {
      "type": "Microsoft.Sql/servers/databases",
      "apiVersion": "2023-05-01-preview",
      "name": "[concat(variables('sqlServerName'), '/', variables('ssisDbName'))]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "dependsOn": [
        "[resourceId('Microsoft.Sql/servers', variables('sqlServerName'))]"
      ],
      "sku": {
        "name": "[parameters('sqlSkuName')]"
      },
      "properties": {
        "collation": "SQL_Latin1_General_CP1_CI_AS",
        "maxSizeBytes": 268435456000,
        "zoneRedundant": false
      }
    },
    {
      "type": "Microsoft.DataFactory/factories",
      "apiVersion": "2018-06-01",
      "name": "[variables('dataFactoryName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "publicNetworkAccess": "Enabled"
      }
    },
    {
      "type": "Microsoft.DataFactory/factories/integrationRuntimes",
      "apiVersion": "2018-06-01",
      "name": "[concat(variables('dataFactoryName'), '/IR-AzureSSIS')]",
      "dependsOn": [
        "[resourceId('Microsoft.DataFactory/factories', variables('dataFactoryName'))]",
        "[resourceId('Microsoft.Sql/servers', variables('sqlServerName'))]",
        "[resourceId('Microsoft.Sql/servers/databases', variables('sqlServerName'), variables('ssisDbName'))]"
      ],
      "properties": {
        "type": "Managed",
        "typeProperties": {
          "computeProperties": {
            "location": "[parameters('location')]",
            "nodeSize": "[parameters('ssisNodeSize')]",
            "numberOfNodes": "[parameters('ssisNodeCount')]",
            "maxParallelExecutionsPerNode": "[parameters('ssisMaxParallelExecutions')]"
          },
          "ssisProperties": {
            "catalogInfo": {
              "catalogServerEndpoint": "[reference(resourceId('Microsoft.Sql/servers', variables('sqlServerName'))).fullyQualifiedDomainName]",
              "catalogDatabaseName": "[variables('ssisDbName')]",
              "catalogAdminUserName": "[parameters('sqlAdminLogin')]",
              "catalogAdminPassword": {
                "type": "SecureString",
                "value": "[parameters('sqlAdminPassword')]"
              },
              "catalogPricingTier": "[parameters('sqlSkuName')]"
            },
            "edition": "[parameters('ssisEdition')]"
          }
        }
      }
    },
    {
      "type": "Microsoft.DataFactory/factories/integrationRuntimes",
      "apiVersion": "2018-06-01",
      "name": "[concat(variables('dataFactoryName'), '/IR-SelfHosted')]",
      "dependsOn": [
        "[resourceId('Microsoft.DataFactory/factories', variables('dataFactoryName'))]"
      ],
      "properties": {
        "type": "SelfHosted",
        "typeProperties": {}
      }
    },
    {
      "type": "Microsoft.DataFactory/factories/linkedservices",
      "apiVersion": "2018-06-01",
      "name": "[concat(variables('dataFactoryName'), '/ls-AzureSqlDatabase')]",
      "dependsOn": [
        "[resourceId('Microsoft.DataFactory/factories', variables('dataFactoryName'))]",
        "[resourceId('Microsoft.Sql/servers', variables('sqlServerName'))]",
        "[resourceId('Microsoft.Sql/servers/databases', variables('sqlServerName'), variables('sqlDatabaseName'))]"
      ],
      "properties": {
        "type": "AzureSqlDatabase",
        "typeProperties": {
          "connectionString": "[concat('Server=tcp:', reference(resourceId('Microsoft.Sql/servers', variables('sqlServerName'))).fullyQualifiedDomainName, ',1433;Initial Catalog=', variables('sqlDatabaseName'), ';Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;Authentication=Active Directory Default')]"
        },
        "connectVia": {
          "referenceName": "AutoResolveIntegrationRuntime",
          "type": "IntegrationRuntimeReference"
        }
      }
    },
    {
      "condition": "[not(empty(parameters('blobStorageConnectionString')))]",
      "type": "Microsoft.DataFactory/factories/linkedservices",
      "apiVersion": "2018-06-01",
      "name": "[concat(variables('dataFactoryName'), '/ls-AzureBlobStorage')]",
      "dependsOn": [
        "[resourceId('Microsoft.DataFactory/factories', variables('dataFactoryName'))]"
      ],
      "properties": {
        "type": "AzureBlobStorage",
        "typeProperties": {
          "connectionString": "[parameters('blobStorageConnectionString')]"
        }
      }
    },
    {
      "condition": "[not(empty(parameters('onPremSqlConnectionString')))]",
      "type": "Microsoft.DataFactory/factories/linkedservices",
      "apiVersion": "2018-06-01",
      "name": "[concat(variables('dataFactoryName'), '/ls-OnPremSqlServer')]",
      "dependsOn": [
        "[resourceId('Microsoft.DataFactory/factories', variables('dataFactoryName'))]",
        "[resourceId('Microsoft.DataFactory/factories/integrationRuntimes', variables('dataFactoryName'), 'IR-SelfHosted')]"
      ],
      "properties": {
        "type": "SqlServer",
        "typeProperties": {
          "connectionString": "[parameters('onPremSqlConnectionString')]"
        },
        "connectVia": {
          "referenceName": "IR-SelfHosted",
          "type": "IntegrationRuntimeReference"
        }
      }
    },
    {
      "condition": "[not(empty(parameters('logAnalyticsWorkspaceId')))]",
      "type": "Microsoft.Insights/diagnosticSettings",
      "apiVersion": "2021-05-01-preview",
      "scope": "[concat('Microsoft.DataFactory/factories/', variables('dataFactoryName'))]",
      "name": "[concat(variables('dataFactoryName'), '-diagnostics')]",
      "dependsOn": [
        "[resourceId('Microsoft.DataFactory/factories', variables('dataFactoryName'))]"
      ],
      "properties": {
        "workspaceId": "[parameters('logAnalyticsWorkspaceId')]",
        "logs": [
          {
            "categoryGroup": "allLogs",
            "enabled": true,
            "retentionPolicy": {
              "enabled": true,
              "days": 30
            }
          }
        ],
        "metrics": [
          {
            "category": "AllMetrics",
            "enabled": true,
            "retentionPolicy": {
              "enabled": true,
              "days": 30
            }
          }
        ]
      }
    },
    {
      "condition": "[not(empty(parameters('logAnalyticsWorkspaceId')))]",
      "type": "Microsoft.Insights/diagnosticSettings",
      "apiVersion": "2021-05-01-preview",
      "scope": "[concat('Microsoft.Sql/servers/', variables('sqlServerName'), '/databases/', variables('sqlDatabaseName'))]",
      "name": "[concat(variables('sqlDatabaseName'), '-diagnostics')]",
      "dependsOn": [
        "[resourceId('Microsoft.Sql/servers/databases', variables('sqlServerName'), variables('sqlDatabaseName'))]"
      ],
      "properties": {
        "workspaceId": "[parameters('logAnalyticsWorkspaceId')]",
        "logs": [
          {
            "categoryGroup": "allLogs",
            "enabled": true,
            "retentionPolicy": {
              "enabled": true,
              "days": 30
            }
          }
        ],
        "metrics": [
          {
            "category": "AllMetrics",
            "enabled": true,
            "retentionPolicy": {
              "enabled": true,
              "days": 30
            }
          }
        ]
      }
    }
  ],
  "outputs": {
    "dataFactoryName": {
      "type": "string",
      "value": "[variables('dataFactoryName')]"
    },
    "dataFactoryId": {
      "type": "string",
      "value": "[resourceId('Microsoft.DataFactory/factories', variables('dataFactoryName'))]"
    },
    "dataFactoryPrincipalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.DataFactory/factories', variables('dataFactoryName')), '2018-06-01', 'Full').identity.principalId]"
    },
    "sqlServerFqdn": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Sql/servers', variables('sqlServerName'))).fullyQualifiedDomainName]"
    },
    "sqlDatabaseName": {
      "type": "string",
      "value": "[variables('sqlDatabaseName')]"
    },
    "ssisDatabaseName": {
      "type": "string",
      "value": "[variables('ssisDbName')]"
    },
    "ssisIRName": {
      "type": "string",
      "value": "IR-AzureSSIS"
    },
    "selfHostedIRName": {
      "type": "string",
      "value": "IR-SelfHosted"
    },
    "dwhConnectionString": {
      "type": "string",
      "value": "[concat('Server=tcp:', reference(resourceId('Microsoft.Sql/servers', variables('sqlServerName'))).fullyQualifiedDomainName, ',1433;Database=', variables('sqlDatabaseName'), ';Encrypt=True;TrustServerCertificate=False;')]"
    }
  }
}
